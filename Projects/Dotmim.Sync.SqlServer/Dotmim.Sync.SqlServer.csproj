<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net9.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Authors>Sébastien Pertus</Authors>
        <Company>Microsoft</Company>
        <Title>Dotmim.Sync.SqlServer</Title>
        <Description>Sql Server Sync Provider. Can be used as Client or Server provider. Compatible with .Net Standard 2.0</Description>
        <PackageTags>Dotmim.Sync,Sync, Sql Server Provider, .Net Standard 2.0</PackageTags>
        <PackageProjectUrl>https://mimetis.github.io/Dotmim.Sync/</PackageProjectUrl>
        <PackageId>Opti.Sync.SqlServer</PackageId>
        <Version>0.3.4.1</Version>
        <AssemblyVersion>0.3.0.0</AssemblyVersion>
        <Product>Dotmim.Sync.SqlServer OPTI-Q</Product>
        <PackageReleaseNotes>
            #0.3.4.1
            - fixed missing "nobinaryserializer" parameter forwarding
            #0.3.4.0
            - also, internal (scopeinfo, _tracking) GUID columns are stoed as TEXT COLLATE NOCASE
            #0.3.3.0
            - all GUID columns are stoed as TEXT COLLATE NOCASE
            #0.3.2.0
            - no more requirement for BinaryFormatter in BatchPart (uses Json as alternative)
            #0.3.1.0
            - added .net9 and BinaryFormatter backward compatibility

            #0.3.0.0
            - allowed sqlite to use IsDirty column for change tracking

            #0.2.12.0
            - TableChangesApplyingEventArgs contains the canges view and sync context

            # 0.2.11.1
            - allows to overwrite SqlBuilderProcedure

            #old
            coreprovider.getstatefromdmrow greatly simplified
        </PackageReleaseNotes>
    </PropertyGroup>

    <!--generate NUGET package including symbols ans source on each release build -->
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSource>True</IncludeSource>
        <IncludeSymbols>True</IncludeSymbols>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CSharp" Version="4.5.0" />
        <PackageReference Include="System.Data.SqlClient" Version="4.5.1" />

    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Dotmim.Sync.Core\Dotmim.Sync.Core.csproj" />
    </ItemGroup>
</Project>